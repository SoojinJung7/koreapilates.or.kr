---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthController from '../components/AuthController.astro';
import { siteMeta } from '../data/nav.js';
import { withBase } from '../utils/url.js';
import ChatWidget from '../components/ChatWidget.astro';

// overHero: 헤더를 히어로 위에 투명하게 띄울지 여부(홈 전용).
// 서브페이지는 기본값 false 라 기존 불투명 헤더 그대로입니다.
const { title, description, overHero = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteMeta.short}` : siteMeta.title;
const pageDesc = description || siteMeta.description;
const pretendard = withBase('/fonts/PretendardVariable.woff2');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" href={withBase(siteMeta.favicon)} />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Pretendard';
        font-weight: 45 920;
        font-style: normal;
        font-display: swap;
        src: url('${pretendard}') format('woff2-variations');
      }
    `}></style>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
  </head>
  <body class={overHero ? 'has-over-hero' : ''}>
    <Header overHero={overHero} />
    <main>
      <slot />
    </main>
    <Footer />
    <AuthController />

    <!-- 전 페이지 공통 상담 위젯 (필립톡 백엔드 연동) -->
    <ChatWidget />

    <!-- ── KR / EN 전환 ───────────────────────────────────────────────
         페이지를 두 벌 만들지 않고, 화면의 한글 텍스트 노드를 사전대로 갈아끼운다.
         선택은 localStorage['kpa-lang'] 에 남아 다음 방문에도 이어진다.
         · 사전(/lang/en.json, 약 64KB)은 **EN 을 고른 방문자만** 받아 간다.
           페이지마다 인라인하면 34개 페이지가 통째로 무거워지기 때문.
         · 사전에 없는 문구는 한국어로 남는다(깨지지 않는다).
         · [data-no-i18n] 안은 건드리지 않는다 — 그 컴포넌트가 직접 한/영을 갖고 있다.
         · 달력·인스타처럼 **나중에 그려지는 글자**도 잡아야 하므로
           MutationObserver 로 새로 붙은 노드를 계속 주워 담는다.
           (우리가 바꾸는 건 nodeValue = characterData 라 childList 감시를 다시
            깨우지 않는다 → 무한루프 없음)
    -->
    <script is:inline define:vars={{ DICT_URL: withBase('/lang/en.json') }}>
      (function () {
        var KEY = 'kpa-lang';
        var lang = 'ko';
        var DICT = null;
        var records = [];
        var seen = typeof WeakSet === 'function' ? new WeakSet() : null;
        var loading = null;
        var watching = false;

        function consider(node, out) {
          if (seen && seen.has(node)) return;
          var raw = node.nodeValue;
          if (!raw) return;
          var key = raw.trim();
          if (!key || !Object.prototype.hasOwnProperty.call(DICT, key)) return;
          // [data-no-i18n] 안(=상담 위젯)은 그 컴포넌트가 자기 한/영을 직접 관리한다.
          // 둘 다 손대면 같은 글자를 두 곳이 다투게 된다.
          var host = node.parentElement;
          if (host && host.closest && host.closest('[data-no-i18n]')) return;
          if (seen) seen.add(node);
          var rec = { node: node, ko: raw, key: key };
          records.push(rec);
          out.push(rec);
        }

        // root 아래(자기 자신 포함)의 텍스트 노드 중 사전에 있는 것만 모은다.
        function collect(root) {
          var fresh = [];
          if (!root || !DICT) return fresh;
          if (root.nodeType === 3) { consider(root, fresh); return fresh; }
          if (root.nodeType !== 1 && root.nodeType !== 9 && root.nodeType !== 11) return fresh;
          var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          var n;
          while ((n = walker.nextNode())) consider(n, fresh);
          return fresh;
        }

        function paint(list) {
          for (var i = 0; i < list.length; i++) {
            var r = list[i];
            // 앞뒤 공백/줄바꿈은 그대로 두고 알맹이만 바꾼다(레이아웃 유지).
            r.node.nodeValue = lang === 'en' ? r.ko.replace(r.key, DICT[r.key]) : r.ko;
          }
        }

        // 나중에 그려지는 글자(달력·인스타 등)까지 따라잡는다. 사전을 받은 뒤 한 번만 건다.
        function watch() {
          if (watching || typeof MutationObserver !== 'function') return;
          watching = true;
          new MutationObserver(function (muts) {
            var fresh = [];
            for (var i = 0; i < muts.length; i++) {
              var added = muts[i].addedNodes;
              for (var j = 0; j < added.length; j++) fresh = fresh.concat(collect(added[j]));
            }
            if (fresh.length && lang === 'en') paint(fresh);
          }).observe(document.body, { childList: true, subtree: true });
        }

        function markButtons() {
          var btns = document.querySelectorAll('[data-lang-btn]');
          for (var i = 0; i < btns.length; i++) {
            var on = btns[i].getAttribute('data-lang-btn') === lang;
            btns[i].classList.toggle('is-active', on);
            btns[i].setAttribute('aria-pressed', String(on));
          }
        }

        function render() {
          if (DICT) paint(records);
          document.documentElement.lang = lang;
          markButtons();
        }

        // 사전을 받아 온다(한 번만). 실패하면 조용히 한국어로 남는다.
        function loadDict() {
          if (DICT) return Promise.resolve(DICT);
          if (loading) return loading;
          loading = fetch(DICT_URL)
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
              if (!data) return null;
              DICT = data;
              if (document.body) { collect(document.body); watch(); }
              return DICT;
            })
            .catch(function () { return null; });
          return loading;
        }

        window.__kpaSetLang = function (next) {
          lang = next === 'en' ? 'en' : 'ko';
          try { localStorage.setItem(KEY, lang); } catch (e) {}
          if (lang === 'en') loadDict().then(render);
          else render();
        };

        var saved = 'ko';
        try { saved = localStorage.getItem(KEY) === 'en' ? 'en' : 'ko'; } catch (e) {}
        lang = saved;
        // 저장된 언어가 영어면 DOM 을 기다리지 않고 곧바로 받기 시작한다(전환 깜빡임 최소화).
        if (saved === 'en') loadDict();

        function start() {
          if (saved === 'en') loadDict().then(render);
          else render();
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
        else start();
      })();
    </script>


    <script>
      // 전역 미세 인터랙션: 섹션 등장.
      // prefers-reduced-motion 이면 아예 실행하지 않습니다.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!reduce.matches) {
        const root = document.documentElement;

        // --- 섹션 등장 ---
        // JS 가 살아있을 때만 숨김 클래스를 켜서, 스크립트 실패 시 콘텐츠가 사라지지 않게 한다.
        const targets = document.querySelectorAll('.reveal');
        if (targets.length) {
          root.classList.add('js-reveal');
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          }, { rootMargin: '0px 0px -12% 0px', threshold: 0.06 });
          targets.forEach((el) => io.observe(el));
        }

      }
    </script>
  </body>
</html>
