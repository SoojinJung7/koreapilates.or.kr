---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthController from '../components/AuthController.astro';
import { siteMeta } from '../data/nav.js';
import { withBase } from '../utils/url.js';

// overHero: 헤더를 히어로 위에 투명하게 띄울지 여부(홈 전용).
// 서브페이지는 기본값 false 라 기존 불투명 헤더 그대로입니다.
const { title, description, overHero = false } = Astro.props;
const pageTitle = title ? `${title} | ${siteMeta.short}` : siteMeta.title;
const pageDesc = description || siteMeta.description;
const pretendard = withBase('/fonts/PretendardVariable.woff2');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="icon" href={withBase(siteMeta.favicon)} />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Pretendard';
        font-weight: 45 920;
        font-style: normal;
        font-display: swap;
        src: url('${pretendard}') format('woff2-variations');
      }
    `}></style>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
  </head>
  <body class={overHero ? 'has-over-hero' : ''}>
    <Header overHero={overHero} />
    <main>
      <slot />
    </main>
    <Footer />
    <AuthController />

    <script>
      // 전역 미세 인터랙션: (1) 섹션 등장 (2) 오브젝트 파랄랙스.
      // 둘 다 prefers-reduced-motion 이면 아예 실행하지 않습니다.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!reduce.matches) {
        const root = document.documentElement;

        // --- 섹션 등장 ---
        // JS 가 살아있을 때만 숨김 클래스를 켜서, 스크립트 실패 시 콘텐츠가 사라지지 않게 한다.
        const targets = document.querySelectorAll('.reveal');
        if (targets.length) {
          root.classList.add('js-reveal');
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          }, { rootMargin: '0px 0px -12% 0px', threshold: 0.06 });
          targets.forEach((el) => io.observe(el));
        }

        // --- 파랄랙스 ---
        // 진폭은 data-parallax(px) 로 2~9px 수준. 스크롤과 포인터를 함께 쓰되
        // 합쳐도 한 자릿수 픽셀을 넘지 않아 "움직인다"고 의식되지 않는다.
        const objects = Array.from(document.querySelectorAll('[data-parallax]'));
        if (objects.length) {
          let sy = 0, mx = 0, my = 0, ticking = false;

          const apply = () => {
            ticking = false;
            for (const el of objects) {
              const amp = parseFloat(el.dataset.parallax || '0');
              const px = (mx * amp * 0.5).toFixed(2);
              const py = (my * amp * 0.5 + sy * amp * 0.02).toFixed(2);
              el.style.setProperty('--px', px + 'px');
              el.style.setProperty('--py', py + 'px');
            }
          };
          const schedule = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(apply);
          };

          window.addEventListener('scroll', () => { sy = window.scrollY; schedule(); }, { passive: true });

          // 포인터가 있는 기기에서만 (터치에서는 스크롤분만 적용)
          if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            window.addEventListener('pointermove', (e) => {
              mx = (e.clientX / window.innerWidth) * 2 - 1;   // -1 ~ 1
              my = (e.clientY / window.innerHeight) * 2 - 1;
              schedule();
            }, { passive: true });
          }
        }
      }
    </script>
  </body>
</html>
