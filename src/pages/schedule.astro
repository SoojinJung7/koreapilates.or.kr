---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Calendar from '../components/Calendar.astro';
---
<BaseLayout title="일정 달력" description="KPA 대한필라테스협회 교육·수련·워크샵·세미나·통역 일정 달력." overHero={true}>
  <!-- PAGE HERO -->
  <PageHero
    eyebrow="SCHEDULE"
    title="일정 달력"
    sub="개강·교육·수련·멘토 트레이닝·워크샵·통역까지, 협회의 살아있는 일정을 한눈에 확인하세요."
  />

  <!-- 달력 -->
  <section class="section">
    <div class="wrap">
      <Calendar />
    </div>
  </section>
</BaseLayout>

<style>
  /* 페이지 히어로 (다른 페이지와 동일 패턴) */

</style>
