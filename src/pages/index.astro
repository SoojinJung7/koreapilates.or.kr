<script>
  (function () {
    const intro = document.getElementById('kpa-intro');
    if (!intro) return;

    // 세션당 한 번만 노출 (같은 세션 재방문 시 생략)
    if (sessionStorage.getItem('kpaIntroSeen')) {
      intro.remove();
      return;
    }

    const video = intro.querySelector('video');
    const html = document.documentElement;
    html.classList.add('kpa-intro-lock');

    let dismissed = false;
    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      sessionStorage.setItem('kpaIntroSeen', '1');
      intro.classList.add('is-done');
      html.classList.remove('kpa-intro-lock');
      setTimeout(() => intro.remove(), 700);
    }

    // 재생 종료 시 닫기 + 안전장치(자동재생 차단·오류 대비)
    if (video) {
      video.addEventListener('ended', dismiss);
      video.addEventListener('error', dismiss);
      const p = video.play();
      if (p && typeof p.catch === 'function') p.catch(dismiss);
      setTimeout(dismiss, 15000);
    } else {
      dismiss();
    }
  })();
</script>
