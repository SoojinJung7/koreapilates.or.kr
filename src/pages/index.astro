---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, img } from '../utils/url.js';
import instagram from '../data/instagram.json';
import Calendar from '../components/Calendar.astro';
import Hero from '../components/Hero.astro';
import GlassPanel from '../components/GlassPanel.astro';
import BackgroundObjects from '../components/BackgroundObjects.astro';

const hero = '6f7ec1_f36aeed6d4d946d2b906ca35afd19f27~mv2.jpg';

const features = [
  { t: '6인 소수정예 꽉 찬 250시간', d: '한 반 최대 6인. 밀도 높은 250시간 정규 커리큘럼.' },
  { t: '커뮤니티 기반 학습 지원', d: '실시간 질의응답과 지식 공유로 함께 성장합니다.' },
  { t: '과제 제출 및 피드백', d: '제출한 과제에 강사가 1:1 맞춤 피드백을 드립니다.' },
  { t: '심화과정 36시간 세미나/워크샵', d: '정규 외 심화 세미나·워크샵으로 전문성을 더합니다.' },
  { t: '이력서·자기소개서 작성 & 취업 지원', d: '이력서/자소서부터 면접 준비까지 취업을 돕습니다.' },
  { t: '드레스업 데이', d: '전문가 이미지 메이킹 워크샵, 드레스업 데이.' },
  { t: '교육생 시설 이용 혜택', d: '필라테스 스튜디오·헬스·GX·스파를 무료로 이용.' },
];

const courses = [
  { n: '1', t: '정렬 기반 체형교정 실전교육 (허리·골반·다리)' },
  { n: '2', t: '병리학 (feat. NCPT) 이론 + 실기' },
  { n: '3', t: '특정 인구(키즈·산전산후·실버) + 시퀀스' },
  { n: '4', t: '교재 외 동작 + 말단 해부학 (하지)' },
  { n: '5', t: '정렬 기반 체형교정 실전교육 (목·어깨·등)' },
  { n: '6', t: '정규과정 외 동작 + 말단 해부학 (상지)' },
];

const workshops = [
  { t: 'Franklin Method® 에릭 프랭클린 워크샵', img: '6f7ec1_9f6015ebafd14b97b64037b4e1702540~mv2.jpg' },
  { t: 'Exercise Course 워크샵', img: '6f7ec1_63d891a3e69148d6aca9880cfd26d66a~mv2.jpg' },
  { t: "필라테스 전문 세미나 'Innovations in Pilates'", img: '6f7ec1_358557b5f0614388ba997cca26bc516a~mv2.jpg' },
  { t: '보수(BOSU)와 필라테스의 만남', img: '6f7ec1_07ef8e2dee444480824bd48bbfebe95e~mv2.jpg' },
];

const partners = [
  { tag: '토탈 휘트니스 클럽', name: '스포츠클럽 필립', desc: '몸과 마음을 바로 세우는 곳. 필립(必立)은 건강한 몸에서부터 건전한 마음을 만드는 쾌적한 공간입니다.' },
  { tag: '성장기 운동은 교육입니다', name: '발리 유소년 스포츠클럽', desc: '성장기 아이들을 위한 체계적인 유소년 스포츠 교육.' },
  { tag: '자이로토닉 국제인증강사 교육기관', name: '더 스파이럴 분당', desc: 'Gyrotonic® 국제인증강사 과정을 운영하는 교육기관.' },
  { tag: '1:1 / 듀엣 / 3:1 기구필라테스', name: '필라인필립 스튜디오', desc: '개인 맞춤형 기구 필라테스 프라이빗 스튜디오.' },
];
---
<BaseLayout overHero={true}>
  <!-- 오프닝 인트로 -->
  <div id="kpa-intro" class="kpa-intro" role="presentation">
    <video class="kpa-intro-video" autoplay muted playsinline preload="auto">
      <!-- 투명 배경(알파): Safari/iOS는 HEVC, 그 외는 WebM, 폴백 mp4 -->
      <source src={withBase('/videos/intro.mov')} type="video/mp4; codecs=hvc1" />
      <source src={withBase('/videos/intro.webm')} type="video/webm" />
      <source src={withBase('/videos/intro.mp4')} type="video/mp4" />
    </video>
  </div>

  <Hero poster={hero} />

  <!-- ===== SCHEDULE — 유리 위의 달력 ===== -->
  <section id="kpa-today" class="section schedule-sec">
    <BackgroundObjects variant="quiet" />
    <div class="wrap schedule-inner">
      <header class="split reveal">
        <div class="split-lead">
          <p class="eyebrow eyebrow--rule eyebrow--accent">Schedule</p>
          <h2>생생하게 전하는<br />KPA의 오늘</h2>
        </div>
        <div class="split-aside">
          <p>성장하는 분들을 위한 KPA의 활동은 지금도 진행 중입니다.</p>
          <a class="text-link" href={withBase('/schedule')}>
            일정 달력 전체 보기
            <svg width="13" height="9" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </header>

      <div class="schedule-body reveal">
        <Calendar />
      </div>
    </div>
  </section>

  <!-- ===== MESSAGE — 오직 타이포그래피와 여백 ===== -->
  <section class="section message">
    <div class="wrap">
      <p class="eyebrow eyebrow--rule reveal">KPA Education System</p>
      <h2 class="message-title reveal">
        실무에<br />
        <em>강하다</em>
      </h2>
      <p class="message-sub reveal">
        필라테스 전문가를 양성하는<br />KPA의 체계적 교육 시스템
      </p>
    </div>
  </section>

  <!-- ===== FEATURES — 카드 그리드가 아니라 에디토리얼 목록 ===== -->
  <section class="section features">
    <div class="wrap">
      <ol class="feature-list">
        {features.map((f, i) => (
          <li class="feature-row reveal">
            <span class="feature-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== JOURNEY — 풀블리드 이미지 ===== -->
  <section class="journey">
    <div class="journey-media" style={`background-image:url(${img('6f7ec1_768862861dbc4078b2faad3c142dacc7~mv2.jpg')})`}></div>
    <div class="wrap journey-inner">
      <p class="eyebrow eyebrow--rule journey-eyebrow reveal">Since 2018</p>
      <h2 class="journey-title reveal">Journey<br />with KPA</h2>
    </div>
  </section>

  <!-- ===== ADVANCED — 떠 있는 유리 패널 ===== -->
  <section class="section advanced">
    <BackgroundObjects variant="quiet" />
    <div class="wrap advanced-inner">
      <GlassPanel tone="dark" class="advanced-panel reveal">
        <div class="advanced-head">
          <div>
            <p class="eyebrow eyebrow--rule eyebrow--accent">Advanced Course</p>
            <h2>지식 전달의 기술을 배우는,<br />KPA 심화과정</h2>
          </div>
          <p class="advanced-target">교육대상<br /><b>사단법인 대한필라테스협회 졸업생<br />및 타 협회 필라테스 강사</b></p>
        </div>

        <ol class="course-list">
          {courses.map((c) => (
            <li class="course-row">
              <span class="course-num">{c.n}</span>
              <p>{c.t}</p>
            </li>
          ))}
        </ol>

        <a class="btn btn--filled advanced-cta" href={withBase('/category/all-products')}>
          심화과정 수강신청
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </GlassPanel>
    </div>
  </section>

  <!-- ===== TESTIMONIAL — 잉크 바탕, 타이포 중심 ===== -->
  <section class="section testimonial">
    <div class="wrap">
      <blockquote class="reveal">
        이력서 작성하는 게 걱정되었는데, 강사님께서 꼼꼼하게 내용 피드백 해주셔서 쉽게 해결되었습니다!
        너무 너무 만족한 6개월 수강이었어요.
      </blockquote>
      <cite class="reveal">155기 졸업생 박○○</cite>
    </div>
  </section>

  <!-- ===== WORKSHOPS — 비대칭 이미지 배치 ===== -->
  <section class="section workshops">
    <div class="wrap">
      <header class="split reveal">
        <div class="split-lead">
          <p class="eyebrow eyebrow--rule eyebrow--accent">Workshop &amp; Seminar</p>
          <h2>워크샵 · 세미나</h2>
        </div>
        <div class="split-aside">
          <a class="text-link" href={withBase('/workshop-seminar')}>
            전체 보기
            <svg width="13" height="9" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </header>

      <div class="workshop-grid">
        {workshops.map((w, i) => (
          <a class={`workshop-card workshop-card--${i}`} href={withBase('/workshop-seminar')}>
            <div class="workshop-img" style={`background-image:url(${img(w.img)})`}></div>
            <h3>{w.t}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== INSTAGRAM ===== -->
  <section class="section instagram">
    <div class="wrap">
      <header class="split reveal">
        <div class="split-lead">
          <p class="eyebrow eyebrow--rule eyebrow--accent">Instagram</p>
          <h2>KPA 인스타그램</h2>
        </div>
        <div class="split-aside">
          <a class="ig-handle" href={instagram.profile} target="_blank" rel="noopener">@{instagram.handle}</a>
        </div>
      </header>

      <div class="ig-grid">
        {instagram.posts.slice(0, 3).map((post) => (
          <a class="ig-card reveal" href={post.permalink} target="_blank" rel="noopener" aria-label="인스타그램에서 보기">
            <div class="ig-img" style={`background-image:url(${withBase(post.image)})`}>
              <span class="ig-overlay">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
                  <circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/>
                </svg>
              </span>
            </div>
            {post.caption && <p class="ig-caption">{post.caption}</p>}
          </a>
        ))}
      </div>
      <a class="btn ig-cta" href={instagram.profile} target="_blank" rel="noopener">인스타그램 팔로우</a>
    </div>
  </section>

  <!-- ===== OUR BRAND — 헤어라인 목록 ===== -->
  <section class="section brand">
    <div class="wrap">
      <p class="eyebrow eyebrow--rule reveal">Our Brand</p>
      <h2 class="brand-title reveal">함께하는 브랜드</h2>
      <ul class="partner-list">
        {partners.map((p) => (
          <li class="partner-row reveal">
            <div class="partner-main">
              <p class="partner-tag">{p.tag}</p>
              <h3>{p.name}</h3>
            </div>
            <p class="partner-desc">{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  /* =========================================================
     오프닝 인트로 (기존 동작 유지)
     ========================================================= */
  .kpa-intro {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    background: #2A1D16;
    opacity: 1; transition: opacity 0.6s ease;
  }
  .kpa-intro.is-done { opacity: 0; pointer-events: none; }
  .kpa-intro-video { width: min(37vw, 160px); height: auto; display: block; }
  :global(html.kpa-intro-lock), :global(html.kpa-intro-lock body) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .kpa-intro { transition: none; } }

  /* =========================================================
     공통 — 비대칭 섹션 헤더 / 텍스트 링크
     ========================================================= */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-bottom: clamp(38px, 5vw, 66px);
  }
  .split-lead h2 {
    margin: 0;
    font-size: clamp(28px, 3.9vw, 50px);
    color: var(--kp-ink);
  }
  .split-aside { padding-bottom: 6px; }
  .split-aside p {
    margin: 0 0 18px;
    color: var(--kp-stone-dk);
    font-size: 15px; line-height: 1.85;
    max-width: 34ch;
  }

  .text-link {
    display: inline-flex; align-items: center; gap: 9px;
    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    color: var(--kp-orange-deep);
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    transition: gap .34s var(--ease), color .34s var(--ease);
  }
  .text-link:hover { gap: 15px; color: var(--kp-ink); }

  /* =========================================================
     SCHEDULE
     ========================================================= */
  .schedule-sec {
    position: relative; overflow: hidden;
    background:
      linear-gradient(180deg, var(--kp-sand-100) 0%, var(--kp-sand-50) 60%);
  }
  .schedule-inner { position: relative; z-index: 4; }
  /* 달력은 기능 위젯이라 유리로 또 감싸지 않는다.
     헤어라인 하나로 영역만 구분하고 바탕 위에 그대로 올린다. */
  .schedule-body { border-top: 1px solid var(--kp-sand-300); padding-top: clamp(22px, 3vw, 40px); }

  /* =========================================================
     MESSAGE — 타이포그래피만으로 버티는 구간
     ========================================================= */
  .message {
    background: var(--kp-sand-50);
    padding-block: clamp(88px, 11vw, 156px);
  }
  .message .eyebrow { color: var(--kp-stone-dk); }
  .message-title {
    margin: 0 0 clamp(26px, 4vw, 46px);
    font-size: clamp(48px, 10.5vw, 132px);
    font-weight: 300;               /* 크기가 큰 만큼 두께는 뺀다 */
    letter-spacing: -0.055em;
    line-height: .92;
    color: var(--kp-ink);
  }
  .message-title em {
    font-style: normal;
    font-weight: 600;
    color: var(--kp-orange-deep);
  }
  .message-sub {
    margin: 0;
    margin-top: clamp(-10px, -1vw, 0px);
    /* 헤드라인 왼쪽 정렬을 깨고 오른쪽으로 밀어 시선을 대각선으로 흘린다 */
    margin-left: auto;
    max-width: 30ch;
    text-align: right;
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.9;
    color: var(--kp-stone-dk);
  }

  /* =========================================================
     FEATURES — 동일 카드 반복 대신 번호가 붙은 목록
     ========================================================= */
  .features { background: var(--kp-sand-50); padding-top: 0; }
  .feature-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--kp-sand-300); }
  .feature-row {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: baseline;
    padding: clamp(24px, 3vw, 38px) 0;
    border-bottom: 1px solid var(--kp-sand-300);
    transition: background-color .5s var(--ease), padding-left .5s var(--ease);
  }
  .feature-row:hover { background: rgba(247,148,28,.045); padding-left: 14px; }
  .feature-num {
    font-size: 12px; font-weight: 700; letter-spacing: .16em;
    color: var(--kp-orange-deep);
  }
  .feature-row h3 {
    margin: 0;
    font-size: clamp(18px, 2vw, 25px);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.35;
    color: var(--kp-ink);
  }
  .feature-row p {
    margin: 0;
    font-size: 15px; line-height: 1.85; color: var(--kp-stone-dk);
  }

  /* =========================================================
     JOURNEY — 풀블리드
     ========================================================= */
  .journey {
    position: relative; overflow: hidden;
    min-height: clamp(400px, 62vh, 640px);
    display: flex; align-items: flex-end;
    padding-block: clamp(48px, 7vw, 92px);
    color: #fff;
  }
  .journey-media {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    /* 아주 느린 확대 — 스크롤 중 눈치채기 어려운 정도 */
    animation: journey-breathe 28s ease-in-out infinite alternate;
  }
  .journey-media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(102deg, rgba(28,16,18,.72) 0%, rgba(28,16,18,.40) 52%, rgba(28,16,18,.18) 100%);
  }
  .journey-inner { position: relative; z-index: 2; }
  .journey-eyebrow { color: rgba(255,255,255,.7); }
  .journey-title {
    margin: 0;
    font-size: clamp(42px, 8vw, 108px);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: .96;
    color: #fff;
  }
  @keyframes journey-breathe {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  @media (prefers-reduced-motion: reduce) { .journey-media { animation: none; } }

  /* =========================================================
     ADVANCED — 떠 있는 유리 패널
     ========================================================= */
  .advanced {
    position: relative; overflow: hidden;
    background: linear-gradient(168deg, var(--kp-sand-200) 0%, var(--kp-sand-100) 55%, var(--kp-sand-50) 100%);
  }
  .advanced-inner { position: relative; z-index: 4; }
  .advanced-panel { padding: clamp(30px, 4.6vw, 68px); }
  .advanced-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, .6fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: end;
    padding-bottom: clamp(28px, 3.4vw, 44px);
    border-bottom: 1px solid rgba(28,16,18,.12);
  }
  .advanced-head h2 {
    margin: 0;
    font-size: clamp(25px, 3.4vw, 42px);
    color: var(--kp-ink);
  }
  .advanced-target {
    margin: 0; text-align: right;
    font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--kp-stone-dk); line-height: 2;
  }
  .advanced-target b {
    display: block; margin-top: 8px;
    font-size: 13.5px; letter-spacing: 0; text-transform: none;
    color: var(--kp-ink); font-weight: 600; line-height: 1.7;
  }

  .course-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 60px);
  }
  .course-row {
    display: flex; gap: 18px; align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid rgba(28,16,18,.09);
  }
  .course-num {
    flex-shrink: 0;
    font-size: 12px; font-weight: 700; letter-spacing: .14em;
    color: var(--kp-orange-deep);
  }
  .course-row p { margin: 0; font-size: 15.5px; line-height: 1.6; color: var(--kp-ink); }
  .advanced-cta { margin-top: clamp(30px, 3.6vw, 48px); }
  .advanced-cta svg { transition: transform .4s var(--ease); }
  .advanced-cta:hover svg { transform: translateX(4px); }

  /* =========================================================
     TESTIMONIAL
     ========================================================= */
  .testimonial {
    background: var(--kp-ink); color: #fff;
    padding-block: clamp(84px, 12vw, 168px);
  }
  .testimonial blockquote {
    position: relative;
    margin: 0 0 30px;
