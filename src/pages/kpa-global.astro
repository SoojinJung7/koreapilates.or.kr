---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../utils/url.js';

const kakaoChat = 'https://pf.kakao.com/_vIRDxl/chat';
const heroImg = '6f7ec1_a83cbb7373c448a18e9b390df45c6eb1~mv2.jpeg';
---
<BaseLayout title="해외 현지 KPA 교육" overHero={true}>
  <PageHero
    eyebrow="KPA GLOBAL"
    title="해외 현지 KPA 교육"
    image={heroImg}
  >
    해외 현지에서 진행하는 KPA 교육 프로그램입니다.
  </PageHero>

  <section class="section soon">
    <div class="wrap soon-inner">
      <p class="eyebrow">COMING SOON</p>
      <h2>페이지를 준비하고 있어요</h2>
      <p>
        해외 현지 KPA 교육 안내를 준비 중입니다. 궁금한 점은 카카오톡으로 편하게
        문의해 주세요.
      </p>
      <div class="soon-actions">
        <a class="btn btn--filled" href={kakaoChat} target="_blank" rel="noopener">카카오톡 상담</a>
        <a class="btn" href={withBase('/global-seminar')}>해외 초청 세미나 보기</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .soon-inner { max-width: 640px; text-align: center; margin-inline: auto; }
  .soon-inner h2 { color: var(--ink-strong); font-size: clamp(26px, 3.8vw, 40px); margin: 6px 0 16px; }
  .soon-inner p { color: var(--ink-muted); line-height: 1.9; margin: 0 0 28px; }
  .soon-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
