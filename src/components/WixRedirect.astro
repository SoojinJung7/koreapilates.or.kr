---
// 옛 Wix 커뮤니티 주소로 들어온 방문자를 Wix 원본으로 자동 이동시키는 최소 페이지.
// GitHub Pages는 서버 리다이렉트가 없어 meta refresh + JS 로 처리한다.
const { to, title = 'KPA 커뮤니티로 이동 중' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>{title}</title>
    <link rel="canonical" href={to} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; background: #FBF8F4; color: #1C1012; }
      .box { text-align: center; padding: 32px; }
      p { margin: 0 0 18px; color: #5a4a44; font-size: 15px; }
      a { display: inline-block; padding: 12px 26px; border-radius: 999px; background: #1C1012; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; }
    </style>
  </head>
  <body>
    <div class="box">
      <p>{title}…</p>
      <a href={to}>바로 이동</a>
    </div>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </body>
</html>
