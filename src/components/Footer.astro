---
import { siteMeta } from '../data/nav.js';
import { withBase } from '../utils/url.js';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src={withBase(siteMeta.logo)} alt={siteMeta.name} width="150" height="70" />
      <p class="footer-tagline">Pilates is complete coordination of body, mind, and spirit.</p>
      <p class="footer-tagline-author">— Joseph H. Pilates</p>
    </div>

    <div class="footer-info">
      <p><strong>사단법인 대한필라테스협회</strong></p>
      <p>경기 성남시 분당구 내정로 58, 3층</p>
      <p>TEL. 031-728-7723 &nbsp;/&nbsp; 031-728-7724</p>
      <p>사업자등록번호 129-82-11411</p>
    </div>

    <nav class="footer-links" aria-label="바로가기">
      <a href={withBase('/kpa')}>협회소개</a>
      <a href={withBase('/curriculum')}>커리큘럼</a>
      <a href={withBase('/coursedate')}>교육일정</a>
      <a href={withBase('/ncpt')}>NCPT 자격증</a>
      <a href={withBase('/address')}>오시는길</a>
      <a href={withBase('/members')}>인증 회원 찾기</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <div class="wrap">Copyright@2018 KOREA PILATES. All Rights Reserved.</div>
  </div>
</footer>

<style>
  /* 바로 위 OUR BRAND 섹션이 잉크 바탕이라, 푸터도 같은 바탕으로 이어 붙이고
     헤어라인 하나로만 구분한다. 색을 바꾸면 페이지가 두 동강 난다. */
  .site-footer {
    background: var(--surface-ink);
    color: rgba(255, 255, 255, 0.62);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr .8fr;
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(56px, 7vw, 88px) clamp(36px, 4vw, 52px);
  }
  .footer-brand img { height: 44px; width: auto; filter: brightness(0) invert(1); opacity: .88; }
  .footer-tagline {
    margin: 24px 0 6px;
    font-size: 14.5px; line-height: 1.75; font-weight: 300;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.72);
    max-width: 30ch;
  }
  .footer-tagline-author {
    margin: 0;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent);
  }

  .footer-info p { margin: 0 0 9px; font-size: 13.5px; letter-spacing: 0.01em; line-height: 1.7; }
  .footer-info strong {
    display: block; margin-bottom: 14px;
    color: #fff; font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
  }

  .footer-links { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
  .footer-links a {
    font-size: 13.5px; color: rgba(255, 255, 255, 0.66);
    padding: 5px 0;
    border-bottom: 1px solid transparent;
    transition: color .3s var(--ease), border-color .3s var(--ease);
  }
  .footer-links a:hover { color: #fff; border-bottom-color: var(--accent); }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-block: 24px;
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  @media (max-width: 800px) {
    .footer-inner { grid-template-columns: 1fr; gap: 34px; }
  }
</style>