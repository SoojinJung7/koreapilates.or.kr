---
/**
 * BackgroundObjects — 화면의 깊이를 만드는 조형 오브젝트.
 *
 * 장식이 아니라 composition 요소입니다. 각 오브젝트는
 *   depth="back"  유리 패널 뒤, 강한 blur, 낮은 대비
 *   depth="mid"   유리 패널 뒤, 약한 blur
 *   depth="front" 유리 패널 앞, blur 없음 (일부는 화면 밖으로 잘림)
 * 로 배치되어 foreground–midground–background 가 실제로 겹칩니다.
 *
 * WebGL 없이 radial-gradient + blur 로만 구현합니다.
 * 색은 로고에서 추출한 오렌지(#F7941C) 계열.
 *
 * props
 *   variant : 'hero' | 'quiet'  — 장면별 배치 세트
 */
const { variant = 'hero' } = Astro.props;
---
<div class={`objects objects--${variant}`} aria-hidden="true">
  {variant === 'hero' && (
    <>
      {/* 우상단: 화면 밖으로 크게 잘려나가는 주인공 구 */}
      <span class="obj obj--sphere o-hero-1" data-depth="back" data-parallax="7"></span>
      {/* 좌상단 토러스 — 유리 패널 경계를 가로지른다 */}
      <span class="obj obj--torus  o-hero-2" data-depth="mid"  data-parallax="-5"></span>
      {/* 좌하단: 절반이 잘린 큰 구 */}
      <span class="obj obj--sphere o-hero-3" data-depth="back" data-parallax="4"></span>
      {/* 작은 구 — 패널 앞에 떠 있어 Z축이 드러난다 */}
      <span class="obj obj--sphere o-hero-4" data-depth="front" data-parallax="-9"></span>
      {/* 하단 토러스 */}
      <span class="obj obj--torus  o-hero-5" data-depth="front" data-parallax="6"></span>
      {/* 우측 작은 구 */}
      <span class="obj obj--sphere o-hero-6" data-depth="mid"  data-parallax="-4"></span>
    </>
  )}
  {variant === 'quiet' && (
    <>
      <span class="obj obj--torus  o-q-1" data-depth="back" data-parallax="5"></span>
      <span class="obj obj--sphere o-q-2" data-depth="back" data-parallax="-4"></span>
    </>
  )}
</div>

<style>
  .objects {
    position: absolute; inset: 0;
    overflow: hidden;          /* 화면 밖으로 자연스럽게 잘리게 */
    pointer-events: none;
    z-index: 1;
  }

  .obj {
    position: absolute;
    display: block;
    border-radius: 50%;
    will-change: transform;
    /* 파랄랙스가 얹는 변환과 충돌하지 않도록 개별 속성 사용 */
    translate: var(--px, 0) var(--py, 0);
  }

  /* ---- 구(sphere): 하이라이트 + 코어 + 그림자면으로 입체를 만든다 ---- */
  .obj--sphere {
    background:
      radial-gradient(circle at 30% 26%, rgba(255,255,255,.92), rgba(255,255,255,0) 40%),
      radial-gradient(circle at 38% 32%,
        var(--kp-orange-lit) 0%,
        var(--kp-orange) 42%,
        var(--kp-orange-deep) 74%,
        #A8480B 100%);
  }

  /* ---- 토러스(ring): 가운데를 비운 링 + 살짝 기울여 원근 ---- */
  .obj--torus {
    background: radial-gradient(circle,
      transparent 0 33%,
      var(--kp-orange-lit) 37%,
      var(--kp-orange) 48%,
      var(--kp-orange-deep) 60%,
      transparent 65%);
  }

  /* ---- 깊이 ---- */
  .obj[data-depth="back"]  { filter: blur(14px); opacity: .62; z-index: 1; }
  .obj[data-depth="mid"]   { filter: blur(6px);  opacity: .82; z-index: 2; }
  .obj[data-depth="front"] { filter: blur(0.5px); opacity: .95; z-index: 6; }

  /* =========================================================
     HERO 배치 — 대칭을 피하고 시선이 사선으로 흐르게 둔다
     ========================================================= */
  .o-hero-1 { /* 우상단 주인공, 화면 밖으로 잘림 */
    width: clamp(300px, 34vw, 520px); aspect-ratio: 1;
    top: -14%; right: -8%;
    animation: drift-a 26s ease-in-out infinite;
  }
  .o-hero-2 { /* 좌상단 토러스 */
    width: clamp(140px, 15vw, 230px); aspect-ratio: 1;
    top: 12%; left: 9%;
    rotate: -18deg; scale: 1 .82;
    animation: drift-b 21s ease-in-out infinite;
  }
  .o-hero-3 { /* 좌하단, 절반 잘림 */
    width: clamp(220px, 26vw, 400px); aspect-ratio: 1;
    bottom: -20%; left: -9%;
    animation: drift-a 31s ease-in-out infinite reverse;
  }
  .o-hero-4 { /* 패널 앞 작은 구 */
    width: clamp(52px, 6vw, 92px); aspect-ratio: 1;
    top: 30%; left: 3%;
    animation: drift-b 17s ease-in-out infinite;
  }
  .o-hero-5 { /* 하단 토러스, 패널 앞 */
    width: clamp(96px, 11vw, 168px); aspect-ratio: 1;
    bottom: 8%; left: 34%;
    rotate: 12deg; scale: 1 .74;
    animation: drift-a 23s ease-in-out infinite;
  }
  .o-hero-6 { /* 우측 중단 작은 구 */
    width: clamp(60px, 7vw, 108px); aspect-ratio: 1;
    top: 56%; right: 6%;
    animation: drift-b 28s ease-in-out infinite reverse;
  }

  /* ---- quiet: 하위 섹션용, 훨씬 절제 ---- */
  .o-q-1 {
    width: clamp(200px, 24vw, 360px); aspect-ratio: 1;
    top: -12%; right: -6%; rotate: 24deg; scale: 1 .8;
    opacity: .2;
    animation: drift-b 34s ease-in-out infinite;
  }
  .o-q-2 {
    width: clamp(120px, 14vw, 210px); aspect-ratio: 1;
    bottom: -14%; left: 4%;
    opacity: .18;
    animation: drift-a 29s ease-in-out infinite reverse;
  }

  /* 움직임은 "의식되지 않을 만큼"만 — 최대 14px, 26초 주기 */
  @keyframes drift-a {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50%      { transform: translate3d(6px, -14px, 0); }
  }
  @keyframes drift-b {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50%      { transform: translate3d(-9px, 10px, 0); }
  }

  /* =========================================================
     반응형 — 축소가 아니라 재배치.
     좁은 화면에서는 오브젝트를 텍스트가 없는 가장자리로 밀고
     blur 를 키워 본문 가독성을 지킨다.
     ========================================================= */
  @media (max-width: 1024px) {
    .o-hero-2 { left: 4%; top: 8%; }
    .o-hero-5 { left: 22%; bottom: 5%; }
  }

  @media (max-width: 768px) {
    .obj[data-depth="back"]  { filter: blur(26px); opacity: .42; }
    .obj[data-depth="mid"]   { filter: blur(14px); opacity: .55; }
    .obj[data-depth="front"] { filter: blur(4px);  opacity: .7;  }
    .o-hero-1 { top: -8%; right: -22%; width: clamp(240px, 56vw, 340px); }
    .o-hero-2 { top: 4%; left: -6%; width: 120px; }
    .o-hero-3 { bottom: -12%; left: -26%; width: clamp(200px, 52vw, 300px); }
    .o-hero-4 { top: 14%; left: auto; right: 6%; width: 46px; }
    .o-hero-5 { bottom: 3%; left: auto; right: -8%; width: 110px; }
    .o-hero-6 { display: none; }
    .o-q-1, .o-q-2 { opacity: .18; filter: blur(30px); }
  }

  @media (max-width: 420px) {
    .o-hero-4 { display: none; }
    .o-hero-5 { width: 84px; bottom: 1%; }
  }

  /* 모션 차단: 위치는 유지하고 움직임만 멈춘다 */
  @media (prefers-reduced-motion: reduce) {
    .obj { animation: none !important; }
  }
</style>
